{
	"name": "codemote",
	"version": "0.7.3",
	"description": "Control AI coding agents from your phone",
	"license": "MIT",
	"author": "Cody Holm",
	"homepage": "https://codemote.app",
	"repository": {
		"type": "git",
		"url": "https://github.com/codyholm/codemote.git",
		"directory": "packages/cli"
	},
	"bugs": {
		"url": "https://github.com/codyholm/codemote/issues"
	},
	"keywords": ["ai", "coding", "claude", "opencode", "codex", "gemini", "remote", "mobile", "cli"],
	"type": "module",
	"main": "./dist/cli.js",
	"bin": {
		"codemote": "./dist/cli.js"
	},
	"files": ["dist"],
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"build": "tsup",
		"build:dev": "tsc",
		"start": "node dist/cli.js",
		"dev": "tsc --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {},
	"devDependencies": {
		"@codemote/common": "workspace:*",
		"@codemote/server": "workspace:*",
		"@types/node": "^22.0.0",
		"@types/qrcode-terminal": "^0.12.2",
		"@types/ws": "^8.5.12",
		"bonjour-service": "^1.2.1",
		"chalk": "^5.3.0",
		"qrcode-terminal": "^0.12.0",
		"selfsigned": "^2.4.1",
		"tsup": "^8.5.1",
		"tweetnacl": "^1.0.3",
		"typescript": "^5.6.0",
		"vitest": "^2.1.0",
		"ws": "^8.18.3"
	}
}
