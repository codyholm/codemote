{
	"name": "codemote",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"bin": {
		"codemote": "./packages/cli/dist/cli.js"
	},
	"scripts": {
		"start": "node packages/cli/dist/cli.js",
		"dev": "pnpm build && node packages/cli/dist/cli.js",
		"build": "pnpm -r build",
		"test": "pnpm -r build && vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:exports": "node scripts/format-exports.mjs",
		"ops:reconcile": "node scripts/ops/reconcile-master-plan.mjs",
		"ops:reconcile:closed": "node scripts/ops/reconcile-master-plan.mjs --require-closed",
		"typecheck": "pnpm -r typecheck",
		"prepare": "simple-git-hooks"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"typescript": "^5.6.0",
		"vitest": "^2.1.0",
		"simple-git-hooks": "^2.11.0"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm format:exports && pnpm lint && pnpm typecheck"
	},
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=9.0.0"
	},
	"packageManager": "pnpm@9.15.0"
}
