{
	"name": "codemote",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"bin": {
		"codemote": "./packages/cli/dist/cli.js"
	},
	"scripts": {
		"start": "node packages/cli/dist/cli.js",
		"dev": "pnpm build && node packages/cli/dist/cli.js",
		"build": "pnpm -r build",
		"test": "pnpm -r build && pnpm test:fast && pnpm test:integration",
		"test:fast": "vitest run --config vitest.fast.config.ts",
		"test:integration": "pnpm test:integration:services && pnpm test:integration:git",
		"test:integration:services": "vitest run --config vitest.integration.config.ts",
		"test:integration:git": "vitest run --config vitest.git.config.ts",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:exports": "node scripts/format-exports.mjs",
		"check:staged": "node scripts/check-staged.mjs",
		"setup:quality": "./scripts/setup-quality-tools.sh",
		"ops:reconcile": "node scripts/ops/reconcile-master-plan.mjs",
		"ops:reconcile:closed": "node scripts/ops/reconcile-master-plan.mjs --require-closed",
		"typecheck": "pnpm -r typecheck",
		"prepare": "simple-git-hooks"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"prettier": "3.9.6",
		"simple-git-hooks": "^2.11.0",
		"typescript": "^5.6.0",
		"vitest": "^2.1.0"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm check:staged"
	},
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=9.0.0"
	},
	"packageManager": "pnpm@9.15.0"
}
